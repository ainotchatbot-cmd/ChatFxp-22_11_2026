{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatfxp-com",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/ws", "/robots.txt", "/sitemap.xml"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatfxp-production",
      "database_id": "b312a7d6-08bb-4f11-a243-7ec572d1e07e"
    }
  ],
  "routes": [
    {
      "pattern": "chatfxp.com/*",
      "zone_name": "chatfxp.com"
    },
    {
      "pattern": "www.chatfxp.com/*",
      "zone_name": "chatfxp.com"
    }
  ],
  "vars": {
    "APP_URL": "https://chatfxp.com",
    "SITE_ORIGIN": "https://chatfxp.com"
  }
}