# Local Docker Compose PostgreSQL defaults
POSTGRES_PASSWORD="CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD"
APP_PORT=3000
APP_URL="http://localhost:3000"
SQL_HOST="db"
SQL_PORT=5432
SQL_DB_NAME="chatfxp"
SQL_USER="chatfxp"
SQL_PASSWORD="CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD"

# Firebase Admin service account file path (never commit the JSON key)
GOOGLE_APPLICATION_CREDENTIALS="/run/secrets/firebase-service-account.json"

# Optional app secrets
GEMINI_API_KEY=""
SUPER_ADMIN_EMAILS="your-admin-email@example.com"
