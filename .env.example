# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://chatfxp.com"

# Cloud SQL (PostgreSQL) Runtime Variables (Used ONLY by local Node dev server in AI Studio preview)
SQL_HOST="/cloudsql/PROJECT:REGION:INSTANCE"
SQL_DB_NAME="chatfxp"
SQL_USER="app_user"
SQL_PASSWORD="CHANGE_ME"

# Cloud SQL / Postgres Admin Variables (Used by Drizzle Kit schema push in Node preview)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="CHANGE_ME"

# Cloudflare Workers Production Secrets & Routing (D1, R2, and Workers AI are bound natively in wrangler.jsonc)
SITE_ORIGIN="https://chatfxp.com"
SHADOW_HMAC_SECRET=""
SUPER_ADMIN_EMAILS=""

# Modular OAuth 2.0 Providers (Optional: enable GitHub & Discord community SSO alongside Google Firebase)
OAUTH_SESSION_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
